{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/dromos/?", "dest": "/public/dromos/index.html" },
    { "src": "/ha/?$", "dest": "/public/ha/index.html" },
    { "src": "/ha/(.+)", "dest": "/public/ha/$1" },
    { "src": "/gallery/?$", "dest": "/", "status": 301 },
    { "src": "/category/(.*)", "dest": "/public/index.html" },
    { "src": "/(.*\\.[a-z]+)$", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
